PORT=8080
HOST=127.0.0.1
NODE_ENV=development

# Server-side only. Leave blank to use the labelled local AI fallback.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=

# Indicative market proxy feed for XAU/USD and DXY.
MARKET_DATA_BASE_URL=https://query1.finance.yahoo.com
MARKET_DATA_INTERVAL=1d
MARKET_DATA_RANGE=1mo
MARKET_DATA_TTL_SECONDS=60

# Append-only operational audit log.
AUDIT_LOG_FILE=./data/audit.jsonl

# Optional read-only Longbridge CLI bridge. Leave blank when unavailable.
LONGBRIDGE_BIN=

# Safe paper agent workflows.
MONITOR_DISABLED=false
MONITOR_INTERVAL_SECONDS=60
MONITOR_ZSCORE=2
MONITOR_RULES=

# Guarded live scaffold. Leave disabled for paper-only usage.
ENABLE_LIVE_TRADING=false
LIVE_ADAPTER=disabled
LIVE_KILL_SWITCH=true
METAAPI_TOKEN=
METAAPI_ACCOUNT_ID=
LIVE_ADMIN_TOKEN=
LIVE_APPROVAL_SECRET=
LIVE_APPROVAL_TTL_SECONDS=120
LIVE_MAX_RISK_PCT=1
LIVE_MIN_REWARD_RISK=1.5
LIVE_MAX_DAILY_LOSS_PCT=3
LIVE_MAX_OPEN_POSITIONS=2
LIVE_MAX_STALE_SECONDS=120
LIVE_MAX_SPREAD_PCT=0.1
LIVE_MAX_NOTIONAL=50000
LIVE_MIN_EQUITY=100
LIVE_CIRCUIT_FAILURES=3
LIVE_CIRCUIT_COOLDOWN_SECONDS=300
LIVE_RECONCILE_INTERVAL_SECONDS=
