PORT=8080
HOST=127.0.0.1
NODE_ENV=development

# Server-side only. Leave blank to use the labelled local AI fallback.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=

# Indicative market proxy feed for XAU/USD and DXY.
MARKET_DATA_BASE_URL=https://query1.finance.yahoo.com
MARKET_DATA_INTERVAL=1d
MARKET_DATA_RANGE=1mo
MARKET_DATA_TTL_SECONDS=60

# Optional licensed/indicative adapter. `licensed` requires endpoint + server-only key.
MARKET_DATA_ADAPTER=indicative
MARKET_DATA_ENDPOINT=
MARKET_DATA_API_KEY=
MARKET_DATA_API_KEY_HEADER=Authorization
MARKET_DATA_AUTH_SCHEME=Bearer
MARKET_DATA_TIMEOUT_MS=8000

# Optional live gold/USD news feed (RSS/Atom or JSON). Leave blank for curated mock headlines.
# Supply your own provider URL; the key below stays on the server and is never sent to browsers.
GOLD_USD_NEWS_URL=
NEWS_API_KEY=
NEWS_API_KEY_HEADER=x-api-key
NEWS_CACHE_SECONDS=600
NEWS_REQUEST_TIMEOUT_MS=6000
NEWS_MAX_ITEMS=8
NEWS_FOCUS_ONLY=true

# Append-only operational audit log.
AUDIT_LOG_FILE=./data/audit.jsonl

# Optional read-only Longbridge CLI bridge. Leave blank when unavailable.
LONGBRIDGE_BIN=

# Safe paper agent workflows.
MONITOR_DISABLED=false
MONITOR_INTERVAL_SECONDS=60
MONITOR_ZSCORE=2
MONITOR_RULES=

# Guarded live scaffold. Leave disabled for paper-only usage.
ENABLE_LIVE_TRADING=false
LIVE_ADAPTER=disabled
LIVE_KILL_SWITCH=true
METAAPI_TOKEN=
METAAPI_ACCOUNT_ID=
LIVE_ADMIN_TOKEN=
LIVE_APPROVAL_SECRET=
LIVE_APPROVAL_TTL_SECONDS=120
LIVE_MAX_RISK_PCT=1
LIVE_MIN_REWARD_RISK=1.5
LIVE_MAX_DAILY_LOSS_PCT=3
LIVE_MAX_OPEN_POSITIONS=2
LIVE_MAX_STALE_SECONDS=120
LIVE_MAX_SPREAD_PCT=0.1
LIVE_MAX_NOTIONAL=50000
LIVE_MIN_EQUITY=100
LIVE_CIRCUIT_FAILURES=3
LIVE_CIRCUIT_COOLDOWN_SECONDS=300
LIVE_RECONCILE_INTERVAL_SECONDS=

# Paper demo account and AI self-learning. No real orders are placed in paper mode.
PAPER_STARTING_CAPITAL=100
PAPER_MAX_RISK_PCT=1
PAPER_MAX_DAILY_LOSS_PCT=3
PAPER_MAX_OPEN_POSITIONS=2
PAPER_STATE_FILE=
PAPER_LEARNING_FILE=

# Real MetaApi HTTP adapter. Set LIVE_ADAPTER=metaapi-http to enable; URLs may use {accountId}.
METAAPI_ORDER_URL=
METAAPI_RECONCILE_URL=
METAAPI_AUTH_SCHEME=Bearer
METAAPI_API_KEY_HEADER=Authorization
METAAPI_REQUEST_TIMEOUT_MS=8000

# Market summaries. Leave blank to generate on demand only (minimum 300 seconds).
SUMMARY_INTERVAL_SECONDS=

# Expo push delivery. Never expose PUSH_ADMIN_TOKEN to clients.
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send
EXPO_PUSH_ACCESS_TOKEN=
PUSH_ADMIN_TOKEN=
PUSH_REQUEST_TIMEOUT_MS=8000

# Optional HttpOnly Supabase session. Server-only; browser keeps its publishable key flow.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SESSION_COOKIE_SECRET=
SESSION_COOKIE_NAME=tradewall_session
SESSION_SECURE=true
SESSION_TTL_SECONDS=3600
